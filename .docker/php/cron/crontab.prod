SHELL=/bin/sh
PATH=/usr/local/bin:/usr/bin:/bin

# This cron job must be added manually to the production host.
0 0 1,16 * * root cd /var/www/presentation-portfolio-project-infra && docker compose exec -T backend \
    php bin/console app:projects:sync >> /var/log/projects-sync.log 2>> /var/log/projects-sync-error.log
