###> symfony/framework-bundle ###
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=replace-with-a-random-secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_NAME=app_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=user
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_SERVER_VERSION=16
DATABASE_CHARSET=UTF8
DATABASE_DRIVER=pdo_pgsql
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='https://your-domain.com'
###< nelmio/cors-bundle ###

###> GitHub ###
GITHUB_BASE_URI=https://api.github.com
GITHUB_API_TOKEN=replace-with-a-scoped-token
###< GitHub ###
